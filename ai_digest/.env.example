# Copy this file to ai_digest/.env and fill in your values.
GOOGLE_GENAI_USE_VERTEXAI=FALSE
GOOGLE_API_KEY=your-gemini-api-key          # from https://aistudio.google.com/apikey

# Email (Gmail: create an App Password at https://myaccount.google.com/apppasswords)
EMAIL_SENDER=you@gmail.com
EMAIL_APP_PASSWORD=your-16-char-app-password
EMAIL_TO=you@gmail.com
